# virtualenvs
.venv/
**/.venv/

# python junk
__pycache__/
*.pyc

# big pipeline outputs / datasets (keep OUT of git)
raw_bids/
derivatives/
atlases/templateflow/
containers/*.sif
logs/

# secrets / local-only
code/licenses/
**/license*.txt

# python caches anywhere
**/__pycache__/
**/*.pyc
code/slurm/*.bak.*

# connectome temp/work (keep final matrices trackable)


# connectome outputs (generated; keep OUT of git)

# allow lightweight placeholders/docs
!connectomes/.gitkeep
!connectomes/README.md
!connectomes/CC200/.gitkeep

# connectomes: ignore everything by default
connectomes/**

# but track curated outputs we actually want in git
!connectomes/
!connectomes/CC200/
!connectomes/CC200/abide1/
!connectomes/CC200/abide1/**
!connectomes/CC200/abide2/
!connectomes/CC200/abide2/**

# keep legacy old outputs around but never stage/commit them by accident
connectomes/CC200/ABIDE2/**

# connectome temp/work (never commit)
connectomes/_tmp/
connectomes/_work/
